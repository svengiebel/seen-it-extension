{
  "manifest_version": 3,
  "name": "SeenIt",
  "version": "1.0",
  "description": "Markiert Anzeigen als gesehen oder nicht gesehen.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.immobilienscout24.de/Suche/*",
        "https://www.immobilienscout24.de/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}
